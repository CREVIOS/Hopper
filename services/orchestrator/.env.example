# Orchestrator configuration (HOP-22 25.4). The Go binary reads plain
# environment variables (internal/config/config.go) — there is no .env
# loader; export these in your shell or let your process manager set them.
# This file documents the full surface. Defaults shown are the local ones.

# NATS server for billing/lifecycle events.
#HOPPER_NATS_URL=nats://localhost:4222

# Path to a kubeconfig. Empty = in-cluster config when deployed, or the
# ambient kubectl context locally (e.g. k3d-hopper-dev).
#KUBECONFIG=

# Namespace VM pods are provisioned into.
#KUBERNETES_NAMESPACE=hopper

# Gate singleton work (billing tickers, watcher, reconcile) behind a K8s
# Lease. true in the K8s deployment; leave false for single-instance local dev.
#HOPPER_LEADER_ELECTION=false

# Set by the K8s Deployment via fieldRef (leader-election identity). Not
# needed locally.
#POD_NAME=
