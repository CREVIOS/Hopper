# API gateway configuration (HOP-22 25.4). Copy to `.env` for local dev:
#   cp .env.example .env
# Every setting maps to app/config.py with the HOPPER_ prefix. The values
# below are the LOCAL DEV defaults — you only need to uncomment what you
# change. Production sets these via K8s env / Secrets, never a .env file.

# --- Core wiring ---
#HOPPER_DATABASE_URL=postgresql+asyncpg://hopper:hopper_dev@localhost:5433/hopper
#HOPPER_NATS_URL=nats://localhost:4222
#HOPPER_ORCHESTRATOR_URL=localhost:50051
#HOPPER_FRONTEND_URL=http://localhost:5173
#HOPPER_CALLBACK_URL=http://localhost:5173/api/auth/callback
#HOPPER_CORS_ORIGINS=["http://localhost:5173"]
#HOPPER_DEBUG=false
#HOPPER_NODE_IP=127.0.0.1

# --- Keycloak (OIDC) ---
#HOPPER_KEYCLOAK_URL=http://localhost:8080
#HOPPER_KEYCLOAK_EXTERNAL_URL=http://localhost:8080
#HOPPER_KEYCLOAK_REALM=hopper
#HOPPER_KEYCLOAK_CLIENT_ID=hopper-api
# Confidential-client secret; empty = public client with PKCE.
#HOPPER_KEYCLOAK_CLIENT_SECRET=
# Service-account client for admin API calls (signup, role changes).
# The secret must match the hopper-admin client in YOUR Keycloak
# (scratchpad/kc-bootstrap.sh provisions it locally). SECRET — .env only.
#HOPPER_KEYCLOAK_ADMIN_CLIENT_ID=hopper-admin
#HOPPER_KEYCLOAK_ADMIN_CLIENT_SECRET=

# --- Signup / email verification ---
# JSON list; empty = any domain may sign up.
#HOPPER_ALLOWED_EMAIL_DOMAINS=[]
#HOPPER_REQUIRE_EMAIL_VERIFIED=true
# Brevo HTTPS transactional email (preferred transport). SECRET.
#HOPPER_BREVO_API_KEY=
# SMTP fallback transport. SECRETS.
#HOPPER_SMTP_HOST=
#HOPPER_SMTP_PORT=587
#HOPPER_SMTP_USER=
#HOPPER_SMTP_PASSWORD=
#HOPPER_SMTP_FROM=Hopper <no-reply@localhost>
#HOPPER_SMTP_STARTTLS=true

# --- Signed code-server URLs ---
# >=32 bytes of cryptographic random in production. SECRET.
#HOPPER_CODE_URL_SIGNING_SECRET=change-me-in-production-32bytes-or-more
#HOPPER_CODE_URL_TTL_SECONDS=600

# --- VM admission queue / cluster capacity ---
#HOPPER_CLUSTER_RESERVE_CPU=1
#HOPPER_CLUSTER_RESERVE_MEMORY=2Gi
#HOPPER_CLUSTER_STORAGE_TOTAL=150Gi
#HOPPER_CLUSTER_RESERVE_STORAGE=10Gi
#HOPPER_SCHEDULER_TICK_SECONDS=5

# --- Rate limiting (HOP-19 18.2) ---
#HOPPER_RATE_LIMIT_USER_DEFAULT=120/minute
#HOPPER_RATE_LIMIT_API_KEY=30/minute
#HOPPER_RATE_LIMIT_POD_CREATE=5/minute
#HOPPER_RATE_LIMIT_LOGIN_FAILURES=3/5minutes

# --- Billing / credit alerts ---
#HOPPER_CREDIT_WARNING_MINUTES=[60,30,10,5]
#HOPPER_CREDIT_GRACE_MINUTES=5
