# docker-compose overrides (HOP-22 25.4). Copy to `.env` next to
# docker-compose.yml — compose reads it automatically. These are the local
# dev defaults; none of them are production credentials (prod runs on K8s
# with cluster Secrets).
#POSTGRES_DB=hopper
#POSTGRES_USER=hopper
#POSTGRES_PASSWORD=hopper_dev
#KEYCLOAK_ADMIN=admin
#KEYCLOAK_ADMIN_PASSWORD=admin
