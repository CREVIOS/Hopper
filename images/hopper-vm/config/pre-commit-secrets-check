#!/bin/sh
# Hopper — secrets scan (pre-commit, WARNING ONLY; HOP-19 18.4).
#
# Greps the staged diff for things that look like credentials (AWS keys,
# GitHub/Slack/Google tokens, private keys, hardcoded passwords) and prints a
# loud warning when found. It NEVER blocks the commit — students stay in
# control — but pushing a real secret to a public repo is usually
# irreversible, so the nudge happens before the commit exists.
#
# Installed via `git config --system init.templateDir`, so it lands in every
# repo created with `git init` / `git clone` inside the VM. Remove a repo's
# copy with: rm .git/hooks/pre-commit

# Added lines only (strip the diff's own +++ header lines).
staged=$(git diff --cached -U0 2>/dev/null | grep '^+' | grep -v '^+++')
[ -z "$staged" ] && exit 0

patterns='(A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[0-9A-Z]{16}
-----BEGIN [A-Z ]*PRIVATE KEY
(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36}
github_pat_[A-Za-z0-9_]{22,}
xox[baprs]-[0-9A-Za-z-]{10,}
AIza[0-9A-Za-z_-]{35}
eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}
[Aa][Ww][Ss].{0,30}[0-9A-Za-z/+=]{40}
([Pp]assword|PASSWORD|[Pp]asswd|[Ss]ecret|SECRET|[Tt]oken|TOKEN|[Aa]pi_?[Kk]ey|API_?KEY)[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"']{8,}'

found=0
IFS='
'
for p in $patterns; do
    matches=$(printf '%s\n' "$staged" | grep -cE "$p" 2>/dev/null)
    if [ "${matches:-0}" -gt 0 ] 2>/dev/null; then
        if [ "$found" -eq 0 ]; then
            printf '\n\033[1;33m⚠ WARNING: possible secrets in this commit\033[0m\n' >&2
            printf '  The staged changes contain lines that look like credentials:\n' >&2
        fi
        found=1
        printf '   - %s match(es) of pattern: %.60s\n' "$matches" "$p" >&2
    fi
done
unset IFS

if [ "$found" -eq 1 ]; then
    printf '\n  If these are real secrets, unstage them (git restore --staged <file>),\n' >&2
    printf '  move them into environment variables or an ignored .env file, and\n' >&2
    printf '  rotate anything already pushed. Committing anyway is allowed — this\n' >&2
    printf '  check never blocks.\n\n' >&2
fi

exit 0
