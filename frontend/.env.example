# Frontend dev configuration. Copy to `.env` for local development:
#   cp .env.example .env
#
# This lets you develop the frontend WITHOUT running the backend locally —
# point it at a deployed environment instead.

# --- Client-side calls (browser → Vite dev proxy → backend) ---

# Where `vite dev` forwards /api/* requests.
#   Local api-gateway:   http://127.0.0.1:8000
#   Deployed environment: https://hopper.farefin.com
API_PROXY_TARGET=https://hopper.farefin.com

# Strip the /api prefix before forwarding?
#   true  → local api-gateway (serves routes without /api)
#   false → deployed ingress (it strips /api itself)
API_PROXY_STRIP_PREFIX=false

# Verify TLS certs on an https backend (set true only for valid public certs).
API_PROXY_SECURE=true

# Origin header the proxy presents to the backend. A deployed backend gates
# WebSockets (in-browser terminal, VS Code) by Origin against its CORS allowlist;
# the browser's Origin is localhost, which is rejected. Set this to the backend's
# own origin so the upgrade is accepted.
#   Deployed environment: https://hopper.farefin.com
# Leave unset for a local api-gateway (it already allows localhost).
API_PROXY_ORIGIN=https://hopper.farefin.com

# --- Server-side calls (SvelteKit SSR load functions → backend) ---

# SSR load functions fetch directly via apiUrl(). Point them at the same
# deployed endpoint, INCLUDING the /api prefix the ingress expects.
#   Deployed environment: https://hopper.farefin.com/api
# Leave unset to use a relative /api path (only works with a local backend).
API_INTERNAL_URL=https://hopper.farefin.com/api

# --- Dev-only one-click login (the "Dev login (skip SSO)" button) ---
#
# The real OAuth button can't complete on localhost: the deployed backend
# returns the Keycloak callback to its own host, so the session cookie lands on
# the remote domain, not localhost. The /dev-login route (dev builds only) does
# a direct Keycloak password grant and sets the session cookies itself.
# These are only read by `vite dev`; the route 404s in production.
KEYCLOAK_EXTERNAL_URL=https://hopper.farefin.com
KEYCLOAK_REALM=hopper
KEYCLOAK_CLIENT_ID=hopper-api
# Optional confidential-client secret (leave empty for the public PKCE client).
KEYCLOAK_CLIENT_SECRET=
# Credentials used by /dev-login. Put real dev creds in .env (gitignored).
# Admin account — /dev-login or /dev-login?as=admin.
DEV_LOGIN_USER=admin
DEV_LOGIN_PASS=
# Regular (non-admin) account — /dev-login?as=user.
DEV_LOGIN_USER_ALT=testuser
DEV_LOGIN_PASS_ALT=
